{
  "name": "bvp-evm",
  "version": "1.0.0",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "clean": "hardhat clean",
    "deploy:arbitrum-sepolia": "hardhat run script/deploy_arbitrumSepolia.ts --network arbitrumsepolia",
    "deploy:arbitrum-mainnet": "hardhat run script/deploy_arbitrum.ts --network arbitrumOne",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "slither": "slither . --filter-paths 'lib|node_modules|out|hh-artifacts' || true",
    "mythril:token": "myth analyze contracts/BVPToken.sol || true",
    "mythril:staking": "myth analyze contracts/BVPStaking.sol || true",
    "mythril:lock": "myth analyze contracts/Lock.sol || true"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.1",
    "@types/chai": "^4.3.4",
    "@types/mocha": "^10.0.1",
    "@types/node": "^24.7.2",
    "chai": "^4.3.6",
    "dotenv": "^16.5.0",
    "ethers": "^6.14.0",
    "hardhat": "^2.26.3",
    "hardhat-gas-reporter": "^1.0.10",
    "mocha": "^10.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "solhint": "^4.5.4"
  },
  "dependencies": {
    "@arbitrum/orbit-sdk": "^0.23.1",
    "@openzeppelin/contracts": "4.9.5",
    "@openzeppelin/contracts-upgradeable": "4.9.3",
    "viem": "^1.21.4"
  }
}
